# Fresh Roots frontend environment. Copy to frontend/.env.local and fill in real values.
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time.

# Explicit REST API base URL (overrides the default http://<current-hostname>:8000/api)
# Example: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=

# Explicit WebSocket base URL (overrides the default derived from the page origin).
# When unset, ws:// is used over http and wss:// over https.
# Example: wss://api.yourdomain.com/ws
NEXT_PUBLIC_WS_URL=

# Server-rendered fallback for pages without browser access
# NEXT_PUBLIC_API_URL=http://localhost:8000/api
