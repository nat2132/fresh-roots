# Fresh Roots backend environment. Copy to backend/.env and fill in real values.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"

# Required in production (when DEBUG=False); a dev-only fallback key is used when DEBUG=True
SECRET_KEY=

# Set to False in production. Local dev defaults to True.
DEBUG=True

# Comma-separated list of hosts for the deployed backend, e.g. api.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated lists appended to the localhost defaults
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL connection. Leave unset to use the local SQLite fallback.
# Example: postgres://fresh_roots_user:password@localhost:5432/fresh_roots_db
DATABASE_URL=
